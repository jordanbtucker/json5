{
  "name": "json5",
  "version": "2.2.1",
  "description": "JSON for Humans",
  "main": "lib/index.js",
  "browser": "dist/json5.umd.js",
  "files": [
    "lib",
    "dist",
    "package.json5",
    "src"
  ],
  "engines": {
    "node": "^14 || ^16 || >=18",
    "npm": ">=7"
  },
  "scripts": {
    "build": "run-p -s build:lib build:dist",
    "build:dist": "run-s -s clean:dist webpack",
    "build:lib": "run-s -s clean:lib tsc",
    "changelog:check": "node scripts/changelog/check.js",
    "changelog:update": "node scripts/changelog/update.js",
    "clean:dist": "rimraf dist/*",
    "clean:lib": "rimraf lib/*",
    "coverage": "run-s -c -s test tap:coverage",
    "dependencies": "npm run -s package:update",
    "eslint": "eslint --fix .",
    "format": "run-s -s prettier",
    "lint": "run-s -s eslint",
    "package:update": "node scripts/package/update.js",
    "prepack": "npm run -s build",
    "prepare": "husky install",
    "prettier": "prettier --loglevel warn -w .",
    "preversion": "run-s -s build test",
    "tap": "tap -R spec test",
    "tap:coverage": "tap --coverage-report html",
    "test": "run-s -s format build:lib lint tap",
    "tsc": "tsc",
    "unicode:update": "node scripts/unicode/update.js",
    "version": "run-s -s \"changelog:update -- --add\" \"package:update -- --add\"",
    "webpack": "webpack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/json5/json5.git"
  },
  "keywords": [
    "json",
    "json5",
    "es5",
    "es2015",
    "ecmascript"
  ],
  "author": "Aseem Kishore <aseem.kishore@gmail.com>",
  "contributors": [
    "Max Nanasy <max.nanasy@gmail.com>",
    "Andrew Eisenberg <andrew@eisenberg.as>",
    "Jordan Tucker <jordanbtucker@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/json5/json5/issues"
  },
  "homepage": "http://json5.org/",
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/preset-env": "^7.19.3",
    "@babel/preset-typescript": "^7.18.6",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@commitlint/parse": "^17.0.0",
    "@tsconfig/node14": "^1.0.3",
    "@types/node": "^18.8.3",
    "@types/tap": "^15.0.7",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "@unicode/unicode-14.0.0": "^1.3.1",
    "babel-loader": "^8.2.5",
    "browserslist": "^4.21.4",
    "chalk": "^5.0.1",
    "conventional-changelog-conventionalcommits": "^5.0.0",
    "core-js": "^3.25.3",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.5.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-promise": "^6.0.1",
    "husky": "^8.0.1",
    "json5": "^2.2.1",
    "lint-staged": "^13.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.7.1",
    "regenerate": "^1.4.0",
    "rimraf": "^3.0.2",
    "simple-git": "^3.14.1",
    "tap": "^16.3.0",
    "typescript": "^4.8.4",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
